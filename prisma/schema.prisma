generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String       @id @default(cuid())
  email               String?      @unique
  lastName            String?
  firstName           String?
  image               String?
  emailVerified       DateTime?
  password            String?

  payments Payment[]
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  wasOnline           DateTime? 
  nickname            String?
  accounts            Account[]
  auditLogs           AuditLog[]
  invitationsReceived Invitation[] @relation("InvitationsReceived")
  invitationsSent     Invitation[] @relation("InvitationsSent")
  notifications       Notification[]
  memberships         Membership[]
  sessions            Session[]
  tasksAssigned       Task[]
  ownedWorkspaces     Workspace[]  @relation("WorkspaceOwner")
}

model Membership {
  id          Int              @id @default(autoincrement())
  role        Role             @default(MEMBER)
  userId      String
  workspaceId Int
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

model Project {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  workspaceId Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  auditLogs   AuditLog[]
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Workspace {
  id          Int          @id @default(autoincrement())
  name        String
  tariff      Tariff       @default(FREE)
  payments Payment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  description String?
  ownerId     String?
  avatarUrl   String?      @db.VarChar(512)
  auditLogs   AuditLog[]
  invitations Invitation[]
  notifications Notification[]
  memberships Membership[]
  projects    Project[]
  owner       User?        @relation("WorkspaceOwner", fields: [ownerId], references: [id])
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  projectId   Int
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  priority    TaskPriority @default(LOW)
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([projectId, status, createdAt])
  @@index([dueDate])
  @@index([projectId, priority])
}

model Invitation {
  id               Int              @id @default(autoincrement())
  invitedUserEmail String
  invitedRole      Role             @default(MEMBER)
  inviterId        String?
  invitedUserId    String?
  workspaceId      Int
  status           InvitationStatus @default(PENDING)
  token            String           @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  invitedUser      User?            @relation("InvitationsReceived", fields: [invitedUserId], references: [id], onDelete: SetNull)
  inviter          User?            @relation("InvitationsSent", fields: [inviterId], references: [id], onDelete: SetNull)
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([expiresAt])
  @@index([invitedUserEmail])
}

model Notification {
  id          Int               @id @default(autoincrement())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String

  // опционально – связь с воркспейсом
  workspaceId Int?
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  isRead      Boolean           @default(false)
  metadata    Json?             // сюда можно класть workspaceName, старый тариф и т.п.

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, isRead, createdAt])
}



model Account {
  id                 String   @id @default(cuid())
  userId             String
  provider           String
  providerAccountId  String
  type               String
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  refresh_token      String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

model Payment {
  id            String    @id @default(cuid())
  workspaceId   Int
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId        String?  
  user          User?     @relation(fields: [userId], references: [id])

  tariff        Tariff
  amount        Decimal   @db.Decimal(12, 2) 
  currency      String    @default("KZT")   

  cloudpaymentsId String?  
  invoiceId       String?   
  status          PaymentStatus
  reason          String?   

  // Когда
  paidAt        DateTime? // когда статус стал Completed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Для подписок (будущее)
  isSubscription Boolean @default(false)
  subscriptionId String? // если recurring

  // Связь с тарифом на момент оплаты (чтобы знать, до какого числа продлили)
  validUntil    DateTime? // например, now() + 30 дней

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([paidAt])
  @@index([workspaceId, paidAt])
  @@index([cloudpaymentsId])
}


model AuditLog {
  id          Int          @id @default(autoincrement())
  userId      String?
  workspaceId Int?
  projectId   Int?
  action      AuditActions
  entityType  String
  entityId    String?
  details     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project?     @relation(fields: [projectId], references: [id])
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([entityType, entityId, createdAt])
}

enum PaymentStatus {
  PENDING      // только что создали (если используешь двухстадийку)
  COMPLETED    // успешно списали
  FAILED       // отклонено банком
  CANCELLED    // пользователь отменил
  REFUNDED     // возврат
}

enum Role {
  MEMBER
  OWNER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}


enum NotificationType {
  WORKSPACE_DELETED
  WORKSPACE_INVITE
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  PAYMENT_COMPLETED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum Tariff {
  FREE
  PRO
  BUSINESS
}

enum AuditActions {
  CREATE
  UPDATE
  DELETE
  INVITE_SENT
  INVITE_ACCEPTED
  TASK_STATUS_CHANGED
  TASK_ASSIGNEE_CHANGED
  PROJECT_RENAMED
  LOGIN
  LOGOUT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
